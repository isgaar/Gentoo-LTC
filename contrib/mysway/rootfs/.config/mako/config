font=Noto Sans SemiBold 11
format=<b>%s</b>\n%b
markup=1
actions=1
history=1
max-history=40

anchor=top-right
width=380
height=140
outer-margin=52,12,0,0
margin=6
padding=14,16
border-size=1
border-radius=14
icon-location=left
max-icon-size=42

background-color=#0a0a0bfa
text-color=#f4f4f5ff
border-color=#ffffff24
progress-color=over #ffffff24

default-timeout=8000
ignore-timeout=0
on-button-left=invoke-default-action
on-button-right=dismiss

[urgency=low]
text-color=#a1a1aaff
border-color=#3f3f46aa

[urgency=high]
background-color=#24141bf8
text-color=#ffffffff
border-color=#f7768eff
default-timeout=0

[mode=do-not-disturb]
invisible=1
