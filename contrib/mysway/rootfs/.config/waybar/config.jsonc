{
    "name": "mysway",
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 5,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/launcher",
        "sway/workspaces",
        "sway/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "wireplumber",
        "network",
        "backlight",
        "battery",
        "tray",
        "custom/notifications",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "",
        "tooltip-format": "Aplicaciones  ·  Super+D",
        "on-click": "wofi --show drun --allow-images --insensitive"
    },
    "sway/workspaces": {
        "all-outputs": false,
        "disable-scroll-wraparound": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 52,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - VSCodium": "$1"
        },
        "separate-outputs": true
    },
    "clock": {
        "locale": "es_MX.UTF-8",
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%A, %d de %B de %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "Pausa",
            "deactivated": "Activo"
        },
        "tooltip-format-activated": "Suspensión automática inhibida",
        "tooltip-format-deactivated": "Suspensión automática activa"
    },
    "cpu": {
        "interval": 5,
        "format": " {usage}%",
        "tooltip": false
    },
    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f} GiB de {total:0.1f} GiB"
    },
    "wireplumber": {
        "scroll-step": 5,
        "max-volume": 125,
        "format": " {volume}%",
        "format-muted": "",
        "tooltip-format": "{node_name}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "sh -c 'command -v pavucontrol >/dev/null 2>&1 && pavucontrol'"
    },
    "network": {
        "interval": 5,
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "",
        "format-linked": "",
        "format-disconnected": "",
        "format-disabled": "",
        "tooltip-format-wifi": "{essid}\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "sh -c 'command -v nmtui >/dev/null 2>&1 && kitty -- nmtui'"
    },
    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "~/.local/bin/mysway-brightness up",
        "on-scroll-down": "~/.local/bin/mysway-brightness down"
    },
    "battery": {
        "interval": 15,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-full": " {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "{timeTo}\n{power:.1f} W"
    },
    "tray": {
        "icon-size": 17,
        "spacing": 8
    },
    "custom/notifications": {
        "exec": "~/.local/bin/mysway-notifications status",
        "return-type": "json",
        "interval": 2,
        "format": "{text}",
        "on-click": "makoctl restore",
        "on-click-right": "~/.local/bin/mysway-notifications toggle"
    },
    "custom/power": {
        "format": "",
        "tooltip-format": "Sesión y energía",
        "on-click": "~/.local/bin/mysway-power"
    }
}
