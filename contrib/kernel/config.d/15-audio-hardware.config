# Hardware de audio persistente para ThinkCentre M75s Gen 2
#
# Arquitectura ALSA y temporizador de alta resolución
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HRTIMER=m
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m

# Controlador HD-Audio PCI (AMD Ryzen HD Audio y AMD Cezanne HDMI/DP)
CONFIG_SND_HDA=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_RECONFIG=y

# Codec de audio analógico Realtek ALC623 (familia ALC269)
CONFIG_SND_HDA_CODEC_REALTEK=m

# Audio digital DisplayPort / HDMI de gráficos integrados AMD Radeon Cezanne
CONFIG_SND_HDA_CODEC_HDMI=m

# Coprocesador de audio AMD ACP / Renoir / Cezanne
CONFIG_SND_SOC=m
CONFIG_SND_SOC_AMD_ACP_COMMON=m
CONFIG_SND_SOC_AMD_RENOIR=m
CONFIG_SND_SOC_AMD_ACP6x=m
